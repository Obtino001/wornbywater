{{ 'section-slideshow.css' | asset_url | stylesheet_tag }}
<script src="{{ 'slideshow.js' | asset_url }}" defer="defer"></script>

<div class="slideshow section-{{ section.id }} slideshow--{{ section.settings.color_scheme }}">
  {% liquid
    if section.settings.height != 'adapt'
      assign aspect_ratio_main = section.settings.height | split: '/'
      assign temp_main = aspect_ratio_main[0] | append: '.0'
      assign slide_height_percent = aspect_ratio_main[1] | divided_by: temp_main | times: 100 | round: 2
    else
      if section.blocks.size > 0
        assign min_aspect_ratio = section.blocks[0].settings.image.aspect_ratio
        for block in section.blocks
          if block.settings.image.aspect_ratio < min_aspect_ratio
            assign min_aspect_ratio = block.settings.image.aspect_ratio
          endif
        endfor
        assign slide_height_percent = 1 | divided_by: min_aspect_ratio | times: 100 | round: 2
      endif
    endif
  %}
  <style>
    .section-{{ section.id }} .flickity-viewport {
      padding-top: {{ slide_height_percent }}%;
    }
    .section-{{ section.id }} .flickity-slider {
      margin-top: -{{ slide_height_percent }}%;
    }
  </style>
  <div
    {% if section.settings.full_width == false %}
      class="container"
    {% endif %}
  >
    <div
      class="slideshow__slider"
      data-autoplay="{{ section.settings.enable_autoplay }}"
      data-autoplay-duration="{{ section.settings.slide_duration | times: 1000 }}"
    >
      {% for block in section.blocks %}
        {% liquid
                if section.settings.height != 'adapt'
                  assign aspect_ratio = section.settings.height | split: '/'
                  assign temp = aspect_ratio[0] | append: '.0'
                  assign padding_bottom_desktop = aspect_ratio[1] | divided_by: temp | times: 100 | round: 2
                elsif section.settings.height == 'adapt'
                  if block.settings.desktop_video != blank and block.settings.show_video
                    assign padding_bottom_desktop = 1 | divided_by: block.settings.desktop_video.aspect_ratio | times: 100 | round: 2
                  elsif block.settings.desktop_image != blank
                    assign padding_bottom_desktop = 1 | divided_by: block.settings.desktop_image.aspect_ratio | times: 100 | round: 2
                  elsif block.settings.mobile_video != blank and block.settings.show_video
                    assign padding_bottom_desktop = 1 | divided_by: block.settings.mobile_video.aspect_ratio | times: 100 | round: 2
                  elsif block.settings.mobile_image != blank
                    assign padding_bottom_desktop = 1 | divided_by: block.settings.mobile_image.aspect_ratio | times: 100 | round: 2
                  else
                    assign padding_bottom_desktop = 0
                  endif
                endif

                if section.settings.mobile_height != 'adapt'
                  assign aspect_ratio_mobile = section.settings.mobile_height | split: '/'
                  assign temp_mobile = aspect_ratio_mobile[0] | append: '.0'
                  assign padding_bottom_mobile = aspect_ratio_mobile[1] | divided_by: temp_mobile | times: 100 | round: 2
                elsif section.settings.mobile_height == 'adapt'
                  if block.settings.mobile_video != blank and block.settings.show_video
                    assign padding_bottom_mobile = 1 | divided_by: block.settings.mobile_video.aspect_ratio | times: 100 | round: 2
                  elsif block.settings.mobile_image != blank
                    assign padding_bottom_mobile = 1 | divided_by: block.settings.mobile_image.aspect_ratio | times: 100 | round: 2
                  elsif block.settings.desktop_video != blank and block.settings.show_video
                    assign padding_bottom_mobile = 1 | divided_by: block.settings.desktop_video.aspect_ratio | times: 100 | round: 2
                  elsif block.settings.desktop_image != blank
                    assign padding_bottom_mobile = 1 | divided_by: block.settings.desktop_image.aspect_ratio | times: 100 | round: 2
                  else
                    assign padding_bottom_mobile = 0
                  endif
                endif
              %}
        <div
          class="slideshow__slide slideshow__slide-{{ block.id }} color-{{ block.settings.color_scheme }}"
          {{ block.shopify_attributes }}
        >
          {% style %}
            .section-{{ section.id }} .slideshow__slide-{{ block.id }}::before {
              content: "";
              display: block;
              padding-bottom: {{ padding_bottom_mobile }}%;
            }

            @media screen and (min-width: 576px) {
              .section-{{ section.id }} .slideshow__slide-{{ block.id }}::before {
                content: "";
                display: block;
                padding-bottom: {{ padding_bottom_desktop }}%;
              }
            }
          {% endstyle %}
          {% if section.settings.full_width == true %}
            <div class="slideshow__slide-container container">
          {% endif %}
          <div class="media">
            <div class="slideshow__overlay" style="opacity: {{ block.settings.overlay_opacity }}"></div>
            {% if block.settings.image != blank %}
              {%- capture sizes -%}
                100vw
              {%- endcapture -%}
              {% liquid 
                if block.settings.mobile_image != blank
                  assign image_class = 'slideshow__image desktop_image'
                else
                  assign image_class = 'slideshow__image'
                endif
              %}
              {{
                block.settings.image
                | image_url: width: 1800
                | image_tag:
                  class: image_class,
                  loading: 'lazy',
                  sizes: sizes,
                  widths: '246, 493, 600, 713, 823, 990, 1100, 1206, 1346, 1426, 1646, 1800'
              }}
            {% endif %}
            {% if block.settings.mobile_image != blank %}
              {%- capture sizes -%}
                100vw
              {%- endcapture -%}
              {% liquid
                if block.settings.image != blank
                  assign image_class = 'slideshow__image mobile_image'
                else
                  assign image_class = 'slideshow__image'
                endif
              %}
              {{
                block.settings.mobile_image
                | image_url: width: 1800
                | image_tag:
                  class: image_class,
                  loading: 'lazy',
                  sizes: sizes,
                  widths: '246, 493, 600, 713, 823, 990, 1100, 1206, 1346, 1426, 1646, 1800'
              }}
            {% endif %}
          </div>
          <div class="slideshow__content-wrapper">
            {% if block.settings.subheading != blank %}
              <div class="slideshow__subheading subtitle">
                {{ block.settings.subheading | escape }}
              </div>
            {% endif %}
            {% if block.settings.heading != blank %}
              <h2 class="slideshow__title title--section {% if block.settings.heading_size == 'medium' %}h3{% else %}h2{% endif %}">
                {{ block.settings.heading }}
              </h2>
            {% endif %}
            {% if block.settings.description != blank %}
              <div class="slideshow__description">
                {{ block.settings.description }}
              </div>
            {% endif %}
            {% if block.settings.button_label != blank and block.settings.show_button %}
              <a
                {% if block.settings.button_link.url != blank %}
                  href="{{ block.settings.button_link }}"
                {% endif %}
                class="slideshow__button button button--arrow button--{{ block.settings.button_style }} button--primary-size"
                {% if block.settings.button_link.url == blank %}
                  aria-disabled="true"
                {% endif %}
              >
                <span>
                  {{ block.settings.button_label | escape }}
                </span>
                {% render 'icon-button-arrow' %}
              </a>
            {% endif %}
          </div>
          {% if section.settings.full_width == true %}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.slideshow.name",
  "tag": "section",
  "class": "slideshow-section spaced-section",
  "enabled_on": {
    "templates": ["*"]
  },
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "options": [
        {
          "value": "light",
          "label": "t:sections.slideshow.settings.color_scheme.options__1.label"
        },
        {
          "value": "dark",
          "label": "t:sections.slideshow.settings.color_scheme.options__2.label"
        }
      ],
      "default": "light",
      "label": "t:sections.slideshow.settings.color_scheme.label"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "default": true,
      "label": "t:sections.slideshow.settings.full_width.label"
    },
    {
      "type": "select",
      "id": "height",
      "options": [
        {
          "value": "1/1",
          "label": "t:sections.slideshow.settings.height.options__1.label"
        },
        {
          "value": "3/2",
          "label": "t:sections.slideshow.settings.height.options__2.label"
        },
        {
          "value": "4/3",
          "label": "t:sections.slideshow.settings.height.options__3.label"
        },
        {
          "value": "16/9",
          "label": "t:sections.slideshow.settings.height.options__4.label"
        },
        {
          "value": "21/9",
          "label": "t:sections.slideshow.settings.height.options__5.label"
        },
        {
          "value": "adapt",
          "label": "t:sections.slideshow.settings.height.options__6.label"
        }
      ],
      "default": "16/9",
      "label": "t:sections.slideshow.settings.height.label"
    },
    {
      "type": "select",
      "id": "mobile_height",
      "options": [
        {
          "value": "1/1",
          "label": "t:sections.slideshow.settings.height.options__1.label"
        },
        {
          "value": "3/2",
          "label": "t:sections.slideshow.settings.height.options__2.label"
        },
        {
          "value": "4/3",
          "label": "t:sections.slideshow.settings.height.options__3.label"
        },
        {
          "value": "16/9",
          "label": "t:sections.slideshow.settings.height.options__4.label"
        },
        {
          "value": "21/9",
          "label": "t:sections.slideshow.settings.height.options__5.label"
        },
        {
          "value": "adapt",
          "label": "t:sections.slideshow.settings.height.options__6.label"
        }
      ],
      "default": "16/9",
      "label": "t:sections.slideshow.settings.mobile_height.label"
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "default": false,
      "label": "t:sections.slideshow.settings.enable_autoplay.label"
    },
    {
      "type": "range",
      "id": "slide_duration",
      "default": 5,
      "min": 1,
      "max": 10,
      "unit": "s",
      "label": "t:sections.slideshow.settings.slide_duration.label"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "t:sections.slideshow.blocks.slide.name",
      "settings": [
        {
          "type": "select",
          "id": "color_scheme",
          "options": [
            {
              "value": "background-1",
              "label": "t:sections.all.color_scheme.options__5.label"
            },
            {
              "value": "background-3",
              "label": "t:sections.all.color_scheme.options__6.label"
            }
          ],
          "default": "background-3",
          "label": "t:sections.all.color_scheme.label"
        },
        {
          "type": "text",
          "id": "subheading",
          "default": "t:sections.slideshow.blocks.slide.settings.subheading.default",
          "label": "t:sections.all.subheading.label"
        },
        {
          "type": "richtext",
          "id": "heading",
          "default": "t:sections.slideshow.blocks.slide.settings.heading.default",
          "label": "t:sections.all.heading.label"
        },
        {
          "type": "select",
          "id": "heading_size",
          "options": [
            {
              "value": "medium",
              "label": "t:sections.all.heading_size.options__1.label"
            },
            {
              "value": "large",
              "label": "t:sections.all.heading_size.options__2.label"
            }
          ],
          "default": "large",
          "label": "t:sections.all.heading_size.label"
        },
        {
          "type": "textarea",
          "id": "description",
          "default": "t:sections.slideshow.blocks.slide.settings.description.default",
          "label": "t:sections.all.text.label"
        },
        {
          "type": "header",
          "content": "t:sections.all.button.header_button.content"
        },
        {
          "type": "checkbox",
          "id": "show_button",
          "default": true,
          "label": "t:sections.all.button.button_show.label"
        },
        {
          "type": "select",
          "id": "button_style",
          "options": [
            {
              "value": "primary",
              "label": "t:sections.all.button.button_style.options__1.label"
            },
            {
              "value": "secondary",
              "label": "t:sections.all.button.button_style.options__2.label"
            }
          ],
          "default": "secondary",
          "label": "t:sections.all.button.button_style.label"
        },
        {
          "type": "text",
          "id": "button_label",
          "default": "t:sections.slideshow.blocks.slide.settings.button_label.default",
          "label": "t:sections.all.button.button_label.label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "t:sections.all.button.button_link.label"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.slideshow.settings.desktop_image.label"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "t:sections.slideshow.settings.mobile_image.label"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "min": 0,
          "max": 1,
          "step": 0.1,
          "label": "t:sections.slideshow.settings.overlay_opacity.label",
          "default": 0.4
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.slideshow.presets.name",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}
