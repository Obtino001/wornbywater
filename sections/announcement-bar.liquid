<announcement-bar
	class="announcement-bar announcement-bar-{% if section.settings.color_scheme == '1' %}1{% endif %}{% if section.settings.color_scheme == '2' %}2{% endif %}"
	role="region"
	aria-label="{{ 'sections.header.announcement' | t }}"
	data-interval="{{ section.settings.change_every | default: 5 | times: 1000 }}"
>
	{%- if section.settings.text != blank -%}
		<div class="announcement-bar__slide is-active" data-announcement-slide>
			{%- if section.settings.link != blank -%}
				<a href="{{ section.settings.link }}" class="announcement-bar__link link link--text focus-inset animate-arrow">
			{%- endif -%}
			<div class="announcement-bar__message">
				{%- if section.settings.image != blank -%}
					<figure class="announcement-bar__image">
						<img srcset="{%- if section.settings.image.width >= 25 -%}{{ section.settings.image | img_url: '25x' }} 25w,{%- endif -%}
								{%- if section.settings.image.width >= 50 -%}{{ section.settings.image | img_url: '50x' }} 50w,{%- endif -%}
								{%- if section.settings.image.width >= 75 -%}{{ section.settings.image | img_url: '75x' }} 75w,{%- endif -%}"
								 src="{{ section.settings.image | img_url: '75x' }}"
								 alt="{{ section.settings.image.alt | escape }}"
								 loading="lazy"
								 width="{{ section.settings.image.width }}"
								 height="{{ section.settings.image.height }}"
						>
					</figure>
				{%- endif -%}
				<span class="announcement-bar__text">{{ section.settings.text }}</span>
			</div>
			{%- if section.settings.link != blank -%}
				</a>
			{%- endif -%}
		</div>
	{%- endif -%}

	{%- if section.settings.text_2 != blank -%}
		<div class="announcement-bar__slide{% if section.settings.text == blank %} is-active{% endif %}" data-announcement-slide>
			{%- if section.settings.link_2 != blank -%}
				<a href="{{ section.settings.link_2 }}" class="announcement-bar__link link link--text focus-inset animate-arrow">
			{%- endif -%}
			<div class="announcement-bar__message">
				<span class="announcement-bar__text">{{ section.settings.text_2 }}</span>
			</div>
			{%- if section.settings.link_2 != blank -%}
				</a>
			{%- endif -%}
		</div>
	{%- endif -%}
</announcement-bar>

<script>
	if (!customElements.get('announcement-bar')) {
		class AnnouncementBar extends HTMLElement {
			connectedCallback() {
				this.slides = Array.from(this.querySelectorAll('[data-announcement-slide]'));
				if (this.slides.length < 2) return;

				this.index = Math.max(0, this.slides.findIndex((slide) => slide.classList.contains('is-active')));
				this.interval = Number(this.dataset.interval) || 5000;
				this.start();
				this.addEventListener('mouseenter', this.stop);
				this.addEventListener('mouseleave', this.start);
			}

			disconnectedCallback() {
				this.stop();
			}

			start = () => {
				this.stop();
				this.timer = window.setInterval(this.next, this.interval);
			};

			stop = () => {
				if (this.timer) window.clearInterval(this.timer);
			};

			next = () => {
				this.slides[this.index].classList.remove('is-active');
				this.index = (this.index + 1) % this.slides.length;
				this.slides[this.index].classList.add('is-active');
			};
		}

		customElements.define('announcement-bar', AnnouncementBar);
	}
</script>

{% schema %}
{
	"name": "t:sections.announcement-bar.name",
	"class": "section-announcement",
	"settings": [
		{
			"type": "select",
			"id": "color_scheme",
			"default": "1",
			"label": "t:sections.announcement-bar.settings.color_scheme.label",
			"options": [
				{
					"value": "1",
					"label": "t:sections.announcement-bar.settings.options__1.label"
				},
				{
					"value": "2",
					"label": "t:sections.announcement-bar.settings.options__2.label"
				}
			]
		},
		{
			"type": "html",
			"default": "t:sections.announcement-bar.settings.text.default",
			"id": "text",
			"label": "t:sections.announcement-bar.settings.text.label"
		},
		{
			"type": "url",
			"id": "link",
			"label": "t:sections.announcement-bar.settings.link.label"
		},
		{
			"type": "image_picker",
			"id": "image",
			"label": "t:sections.announcement-bar.settings.image.label",
			"info": "t:sections.announcement-bar.settings.image.info"
		},
		{
			"type": "html",
			"id": "text_2",
			"default": "Choose two pieces, and I'll make a third at no cost",
			"label": "t:sections.announcement-bar.settings.text_2.label"
		},
		{
			"type": "url",
			"id": "link_2",
			"label": "t:sections.announcement-bar.settings.link_2.label"
		},
		{
			"type": "range",
			"id": "change_every",
			"min": 3,
			"max": 12,
			"step": 1,
			"unit": "s",
			"label": "t:sections.announcement-bar.settings.change_every.label",
			"default": 5
		}
	],
	"default": {
		"settings": {
			"text": "t:sections.announcement-bar.settings.text.default",
			"text_2": "Choose two pieces, and I'll make a third at no cost"
		}
	}
}
{% endschema %}
