{% doc %}
Renders payment method icons in a fixed order matching the cart and footer.
@param {boolean} [show_secure_label] - Show "Secure payment with" above the icons
@example
{% render 'Payments', show_secure_label: true %}
{% enddoc %}

<style>
  .payment-icons-block {
    width: 100%;
  }
  .payment-icons__label {
    margin: 12px 0 8px;
    padding: 0;
    font-size: 1.2rem;
    line-height: 1.4;
    text-align: center;
    color: rgb(var(--color-foreground));
  }
  .payment-icons {
    display: flex;
    gap: 8px;
    justify-content: flex-start;
    align-items: center;
    padding: 8px 0 20px;
    margin: 0;
    flex-wrap: wrap;
    list-style: none;
  }
  .payment-icons-block--labeled .payment-icons {
    justify-content: center;
    padding: 0 0 8px;
  }
  .payment-icons > li {
    height: 22px;
    width: auto;
    margin: 0;
    list-style: none;
  }
  .payment-icons svg {
    display: block;
    height: 22px;
    width: auto;
  }
</style>

<div class="payment-icons-block{% if show_secure_label %} payment-icons-block--labeled{% endif %}">
  {%- if show_secure_label -%}
    <p class="payment-icons__label">{{ 'sections.cart.secure_payment_with' | t }}</p>
  {%- endif -%}
  <ul class="payment-icons" role="list">
    {%- assign payment_types = 'visa,master,american_express,apple_pay,google_pay,shopify_pay' | split: ',' -%}
    {%- for type in payment_types -%}
      <li>{{ type | payment_type_svg_tag }}</li>
    {%- endfor -%}
  </ul>
</div>
