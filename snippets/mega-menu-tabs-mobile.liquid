{% for block in blocks %}
  {% assign mega_menu_tabs_trigger = block.settings.mega_menu_tabs_trigger | handle | strip %}
  {% if link.handle == mega_menu_tabs_trigger and block.type == 'mega_menu_tabs' %}
    <div class="mega-menu__tabs">
      {% if block.settings.enable_tab_1 %}
        <div class="mega-menu__tab">
          <div class="mega-menu__tab-wrapper mega-menu__tab-wrapper--active">
            <div class="mega-menu__tab-info">
              <div class="mega-menu__tab-inner">
                {%- if block.settings.heading_1 != blank -%}
                  <div class="mega-menu__tab-heading">
                    {{ block.settings.heading_1 }}
                  </div>
                {%- endif -%}
                {%- if block.settings.description_1 != blank -%}
                  <p class="mega-menu__tab-text body-small">
                    {{ block.settings.description_1 }}
                  </p>
                {%- endif -%}
                {%- if block.settings.menu_1 != blank -%}
                  <ul class="mega-menu__tab-list list-unstyled hidden" role="list">
                    {%- for link in block.settings.menu_1.links -%}
                      <li class="mega-menu__tab-list-item body-small">
                        <a
                          href="{{ link.url }}"
                          class="mega-menu__tab-list-link focus-inset"
                          aria-label="{{ link.title | escape }}"
                          tabindex="0"
                        >
                          {{- link.title | escape -}}
                        </a>
                      </li>
                    {% endfor %}
                  </ul>
                {%- endif -%}
              </div>
            </div>
          </div>
        </div>
      {% endif %}
