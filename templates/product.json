    "ss_testimonial_12_fg8dw3": {
      "type": "ss-testimonial-12",
      "blocks": {
        "slide_4ybDyF": {
          "type": "slide",
          "settings": {
            "media_style": "image",
            "video_url": "",
            "controls": false,
            "stars_count": 0,
            "text": "<p>I never knew a little piece of the Irish coast could become something I’d wear every day.</p>",
            "author": "<p>Eabha Kearney, Kilkee</p>"
          }
        },
        "slide_nh3hwF": {
          "type": "slide",
          "settings": {
            "media_style": "image",
            "video_url": "",
            "controls": false,
            "stars_count": 0,
            "text": "<p>I wanted jewellery that felt personal, not something you see everywhere.<br/><br/>Something with a story behind it.</p>",
            "author": "<p>Aisling Moran, Ballyvaughan</p>"
          }
        },
        "slide_8Gk9qM": {
          "type": "slide",
          "settings": {
            "media_style": "image",
            "video_url": "",
            "controls": false,
            "stars_count": 0,
            "text": "<p>The thought of wearing a stone shaped by the Atlantic just felt so much more meaningful than buying something mass-produced.</p>",
            "author": "<p>Gráinne Walsh, Keel</p>"
          }
        },
        "slide_tcqgP6": {
          "type": "slide",
          "settings": {
            "media_style": "image",
            "video_url": "",
            "controls": false,
            "stars_count": 0,
            "text": "<p>My stone was found along the West Coast of Ireland and turned into a piece made just for me...<br/><br/>That makes it feel completely different.!</p>",
            "author": "<p>Sorcha Ní Bhraonáin, Kinvara</p>"
          }
        },
        "slide_n4nzdi": {
          "type": "slide",
          "settings": {
            "media_style": "image",
            "video_url": "",
            "controls": false,
            "stars_count": 0,
            "text": "<p>I chose the stone, and they turned it into my jewellery.<br/><br/>Now I’m wearing a tiny piece of the Irish coast that belongs only to me</p>",
            "author": "<p>Caoimhe Ryan, Roundstone</p>"
          }
        },
        "slide_LagNPk": {
          "type": "slide",
          "settings": {
            "media_style": "image",
            "video_url": "",
            "controls": false,
            "stars_count": 5,
            "text": "<p>All my friends want them too now, at least I was the first one to get them..!</p>",
            "author": "<p><strong>@mcqueen</strong></p>"
          }
        },
        "slide_PqyXWm": {
          "type": "slide",
          "settings": {
            "media_style": "image",
            "video_url": "",
            "controls": false,
            "stars_count": 5,
            "text": "<p>I use it every day early in the morning and on our dining table, it is do convenient and cool</p>",
            "author": "<p><strong>@dwithpatty</strong></p>"
          }
        }
      },
