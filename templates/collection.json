    "ss_testimonial_8_68g9G9": {
      "type": "ss-testimonial-8",
      "blocks": {
        "testimonials_3BatFC": {
          "type": "testimonials",
          "settings": {
            "stars_count": 5,
            "heading": "",
            "text": "I lost my dad in March. I didn't know what I wanted, just that I needed something. The stone she found felt like it had been waiting on that beach for me. I can't explain it better than that.",
            "author_date": "Sarah, Christchurch"
          }
        },
        "testimonials_NambPj": {
          "type": "testimonials",
          "settings": {
            "stars_count": 5,
            "heading": "",
            "text": "I never got to give it to her. But now I wear it for her.",
            "author_date": "Pauline, Blenheim"
          }
        },
        "testimonials_4YVyNE": {
          "type": "testimonials",
          "settings": {
            "stars_count": 5,
            "heading": "",
            "text": "Bought it for my sister after we lost Mum. She rang me crying — the good kind. Said it was the first thing in months that felt like it actually understood.",
            "author_date": "Anna, Nelson"
          }
        },
        "testimonials_D4VeGM": {
          "type": "testimonials",
          "settings": {
            "stars_count": 5,
            "heading": "",
            "text": "The clasp is solid, the chain hasn't tarnished, and the stone hasn't shifted once. I wear it every day, in the sea included. Made to last, which matters when it means this much.",
            "author_date": "Janine, Wellington"
          }
        },
        "testimonials_w4wAk6": {
          "type": "testimonials",
          "settings": {
            "stars_count": 5,
            "heading": "",
            "text": "My stone has a line of white running through it. Not perfect. She wrote that no two are the same. I wouldn't swap it for a flawless one. The flaw is the whole point.",
            "author_date": "Lisa, Hokitika"
          }
        },
        "testimonials_NHhBUy": {
          "type": "testimonials",
          "settings": {
            "stars_count": 5,
            "heading": "",
            "text": "I'm not one for words about feelings. I'll just say I've worn it for six months and I'm not taking it off",
            "author_date": "Margaret, Timaru"
          }
        }
      },
