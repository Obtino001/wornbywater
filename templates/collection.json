{"sections":{"banner":{"type":"main-collection-banner","settings":{"heading_tag":"h1","add_word":"Collection","show_word":true,"show_collection_description":true,"show_collection_image":true,"image_width_1":90,"image_width_2":90}},"product-grid":{"type":"main-collection-product-grid","settings":{"products_per_page":22,"image_product_grid_position":"right","heading_tag":"h3","image_ratio":"landscape","image_fit":"contain","show_secondary_image":true,"show_vendor":true,"show_sku":false,"show_desc":true,"enable_filtering":false,"enable_sorting":false,"image_filter_ratio":"3\/2","image_filter_fit":"cover","image_filter_columns":2,"columns_mobile":"2"}},"testimonials_86m3dH":{"type":"testimonials","blocks":{"testimonials_slide_JTPkxy":{"type":"testimonials_slide","settings":{"slide_text":"\"I never got to give it to her. But now I wear it. For her.\"","image":"shopify:\/\/shop_images\/067bc665-d539-453e-b7e8-71bf11ede815_1.png","slide_name":"Saoirse Kelly","slide_position":"Cork"}},"testimonials_slide_f3wyE4":{"type":"testimonials_slide","settings":{"slide_text":"\"I've never been good at saying things out loud. But when she opened it... she looked at me in a way I hadn't seen in a long time.\"","image":"shopify:\/\/shop_images\/Untitled_design_7_1.png","slide_name":"Ciara O'Brien","slide_position":"Galway"}},"testimonials_slide_dTacCB":{"type":"testimonials_slide","settings":{"slide_text":"\"I always feel guilty when I buy something for myself. But with this, it was different. I felt it was something I had deserved for a long time.\"","image":"shopify:\/\/shop_images\/Untitled_design_8.png","slide_name":"Niamh Byrne","slide_position":"Limerick"}}},"block_order":["testimonials_slide_JTPkxy","testimonials_slide_f3wyE4","testimonials_slide_dTacCB"],"settings":{"sub_title":"From those who truly valued it","border_top":false}},"ss_testimonial_8_68g9G9":{"type":"ss-testimonial-8","blocks":{"testimonials_3BatFC":{"type":"testimonials","settings":{"stars_count":5,"heading":"","